            <kind>1</kind>
            <string>///reset properties + image index
if msg != global.msg{
    height = 80;
    hide = 0;
    if msg != "" &amp;&amp; msg != 0{
        //audio_play_sound(sndDrop,0,false);
    }
    msgAt = 0;
    msg = global.msg;
    msgLength = string_length(msg);
    drawString = "";
    msgMod = 0;
    advText = 0;
    alarm[0] = 15;
}
fade = 0;

switch room{
    case r70:
    case r71:
    case r72:
    case r73:
    case r74:
    case r75:
    case r76:
    case r7A:
    case r7B:
        image_index = 1;
        textCol = make_color_rgb(32,0,32);
        puzCol = make_color_rgb(214,207,201);
        puzOutCol = make_color_rgb(62,45,28);
        break;
    case r90:
    case r91:
    case r92:
    case r93:
    case r94:
    case r95:
    case r96:
    case r97:
    case r98:
    case r99:
    case r9A:
    case r9B:
    case r9C:
    case rC0:
    case rC1:
    case rC2:
    case rC3:
    case rC4:
    case rC5:
    case rC6:
        image_index = 2;
        textCol = make_color_rgb(0,32,0);
        puzCol = make_color_rgb(201,214,201);
        puzOutCol = make_color_rgb(35,62,35);
        break;
    default:
        image_index = 0;
        textCol = make_color_rgb(32,0,32);
        puzCol = make_color_rgb(214,207,201);
        puzOutCol = make_color_rgb(62,45,28);
        break;
}
</string>
