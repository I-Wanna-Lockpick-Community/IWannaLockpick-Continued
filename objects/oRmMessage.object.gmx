            advText = 0;
        }
    }
}*/
//drawString = string_copy(msg,1,msgAt);
drawString = msg;

if scrButtonCheckPressed(global.camButton) &amp;&amp; instance_exists(objPlayer) &amp;&amp; global.pmState == 0{
    hide = !hide;
    if visible{
        hideSnd = scrPlaySoundExt(sndDrop,1,1,false);
        audio_sound_pitch(hideSnd,1.5);
    }
}

if hide{
    hideAmt = min(hideAmt + 0.05, 1);
}else{
    hideAmt = max(hideAmt - 0.05, 0);
}

if instance_exists(objPlayer){
    if objPlayer.y &gt; (view_yview+532*view_hview[0]/608){
        pFade = 1;
    }else{
        pFade = 0;
    }
}
if fade || pFade{
    image_alpha = max(image_alpha - 0.04, 0);
}else{
    image_alpha = min(image_alpha + 0.04, 1);
}
</string>
          </argument>
        </arguments>
      </action>
