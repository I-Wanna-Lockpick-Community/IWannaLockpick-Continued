          <argument>
            <kind>1</kind>
            <string>///invisible in certain rooms
switch room{
    case rMainHub:
    case rBackHub:
    case rWayOut:
    case rUltraPuzzle:
    case rHub01:
    case rHub02:
    case rHub03:
    case rHub04:
    case rHub05:
    case rHub06:
    case rHub07:
    case rHub08:
    case rHub09:
    case rHub10:
    case rHub11:
    case rHubGB:
    case rMonolith:
    case rHub05Old:
    case rOmega0:
    case rOmega1:
    case rOmega2:
    case rOmega7:
    case rOmegaD:
        visible = false;
    break;
    default:
        visible = true;
    break;
}
if global.msg == ""{
    visible = false;
}
</string>
