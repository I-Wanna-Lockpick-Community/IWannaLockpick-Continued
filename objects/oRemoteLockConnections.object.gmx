            <string>
with oRemoteLock {
    if active {
        var innerColor = c_black;
        var outerColor = c_black;
        if satisfied {
            innerColor = global.mainTone[color];
            outerColor = c_white;
        }
        var xCenter = x - sprite_get_xoffset(sprite) + w/2 - 1;
        var yCenter = y - sprite_get_yoffset(sprite) + h/2 - 1;
        for (var i = 0; i &lt; doors; i += 1) {
            var thisDoor = door[i];
            if !thisDoor.active {continue;}
            var xCenterDoor = thisDoor.x + thisDoor.w*16 - 1;
            var yCenterDoor = thisDoor.y + thisDoor.h*16 - 1;
            with other {
                draw_line_width_colour(xCenter,yCenter,xCenterDoor,yCenterDoor,4,outerColor,outerColor);
                draw_line_width_colour(xCenter,yCenter,xCenterDoor,yCenterDoor,2,innerColor,innerColor);
            }
        }
    }
}
</string>
