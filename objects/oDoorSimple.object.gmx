      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Main draw
baseColor = color;
baseColorSpend = colorSpend;
if cursed != -1 &amp;&amp; cursed != color_PURE {
    if !armament { baseColor = cursed; }
    baseColorSpend = cursed;
}
if copyDraw == 1 { // spend is not drawn while the copy animation is happening
    scrDrawDoorSpend(baseColorSpend);
}
debrisColor = baseColor;

var noCopies = (global.complexMode == 0 &amp;&amp; copies == 0) || (global.complexMode == 1 &amp;&amp; icopies == 0);
if noCopies {
    // draw the rainbow outline if there aren't copies in this direction
    scrComboDrawIm();
} else {
    var isNegative = false
    if type == lock_BLAST &amp;&amp; (denom != 0 || idenom != 0) {
        if (count == 0 &amp;&amp; denom == 0 &amp;&amp; idenom &lt; 0) ||
            (icount == 0 &amp;&amp; idenom == 0 &amp;&amp; denom &lt; 0) {
                isNegative = true;
            }
    } else if count &lt; 0 || icount &lt; 0 {isNegative = true}

    scrDrawDoorFrame(isNegative != (global.complexMode == 0 &amp;&amp; copies &lt; 0 || global.complexMode == 1 &amp;&amp; icopies &lt; 0));
}
scrDrawDoorLock(baseColor,count,icount,type,0,0,scrSimpleDoorGetLockSprite(),exactI||isPartial,denom,idenom,negated,armament,iPow,noCopies);
scrDrawDoorAura(aura[0],aura[1],aura[2],x,y,w*32,h*32);
</string>
          </argument>
        </arguments>
      </action>
    </event>
